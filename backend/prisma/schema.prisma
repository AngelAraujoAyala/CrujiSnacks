// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reservation {
  id Int @id @default(autoincrement())

  nombreCliente String
  emailCliente  String
  telefono      String

  fecha DateTime?

  fechaInicio DateTime?
  fechaFin    DateTime?

  lugar String

  estado ReservaEstado @default(PENDIENTE)

  createdAt DateTime @default(now())

  toppings ReservaTopping[]
}

model Topping {
  id     Int     @id @default(autoincrement())
  nombre String  // Ej: "Chamoy", "Tajín"
  iconURL String?
  stock  Boolean @default(true) // Para marcar si se agotó
  reservas ReservaTopping[]
}

model ReservaTopping {
  id         Int @id @default(autoincrement())

  reservaId  Int
  toppingId  Int

  reserva    Reservation @relation(fields: [reservaId], references: [id])
  topping    Topping @relation(fields: [toppingId], references: [id])
}

enum ReservaEstado {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}


model Package {
  id          Int      @id @default(autoincrement())
  nombre      String   // Ej: "Paquete Cumpleañero"
  descripcion String?
  precio      Decimal
  activo      Boolean  @default(true)
}

model BloqueoFecha {
  id          Int @id @default(autoincrement())

  fecha       DateTime

  horaInicio  String?
  horaFin     String?

  motivo      String?

  activo      Boolean @default(true)
}

